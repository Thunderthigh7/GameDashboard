# Secret used to sign dashboard user sessions and dashboard tool requests.
DASHBOARD_PASSWORD=change-me
PRESENCE_SECRET=change-me
ADMIN_USERNAMES=
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_OAUTH_REDIRECT_URI=http://localhost:3000/api/roblox/oauth/callback
ROBLOX_OAUTH_SCOPES=openid profile

# Optional AI analysis.
OPENAI_API_KEY=
OPENAI_CHAT_INSIGHTS_MODEL=gpt-5.5
OPENAI_AREA_INSIGHTS_MODEL=gpt-5.5

# Use b2 for the scalable analytics path. Use mongodb only for legacy testing.
ANALYTICS_STORAGE_MODE=b2

# Optional legacy MongoDB persistence. Leave blank when using B2 raw storage.
MONGODB_URI=
MONGODB_DB=roanalytics

# Backblaze B2 S3-compatible object storage for raw compressed analytics batches.
B2_BUCKET_NAME=roanalytics-prod
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=

# Scheduled B2 rollup processor.
ROLLUP_LOOKBACK_HOURS=24
ROLLUP_MAX_RAW_OBJECTS=5000
ROLLUP_UNIVERSE_IDS=

# Scheduled AI report processor.
AI_REPORT_BASE_URL=http://localhost:3000
AI_REPORT_SECRET=
