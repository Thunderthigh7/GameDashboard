# Secret used to sign dashboard user sessions and dashboard tool requests.
DASHBOARD_PASSWORD=change-me
PRESENCE_SECRET=change-me
ADMIN_USERNAMES=
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_OAUTH_REDIRECT_URI=http://localhost:3000/api/roblox/oauth/callback
ROBLOX_OAUTH_SCOPES=openid profile

# Transactional email alerts. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=RoAnalytics <alerts@example.com>

# Optional AI analysis.
OPENAI_API_KEY=
OPENAI_CHAT_INSIGHTS_MODEL=gpt-5.4-nano
OPENAI_AREA_INSIGHTS_MODEL=gpt-5.4-nano
OPENAI_CHATBOT_MODEL=gpt-5.4-nano
OPENAI_CHATBOT_MAX_OUTPUT_TOKENS=700
MAX_AI_CHAT_PROMPT_CHARS=800
MAX_AI_CHAT_CONTEXT_CHARS=12000
MAX_AI_CHAT_HISTORY_MESSAGES=8
MAX_AI_CHAT_HISTORY_CHARS=6000

# Use b2 for the scalable analytics path. Use mongodb only for legacy testing.
ANALYTICS_STORAGE_MODE=b2

# Optional legacy MongoDB persistence. Leave blank when using B2 raw storage.
MONGODB_URI=
MONGODB_DB=roanalytics

# Backblaze B2 S3-compatible object storage for raw compressed analytics batches.
B2_BUCKET_NAME=roanalytics-prod
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_CONNECTION_TIMEOUT_MS=5000
B2_REQUEST_TIMEOUT_MS=60000
B2_SOCKET_TIMEOUT_MS=30000
B2_MAX_ATTEMPTS=3
# Keep interactive dashboard reads bounded separately from long-running workers.
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=5000

# Short-lived interactive caches keep repeat dashboard views fast.
ACCOUNT_USAGE_RESPONSE_CACHE_MS=30000
MAX_ACCOUNT_USAGE_RESPONSE_CACHE_ENTRIES=200
ADMIN_RESPONSE_CACHE_MS=60000
ADMIN_SNAPSHOT_REFRESH_CONCURRENCY=2
CURRENT_USAGE_SNAPSHOT_MAX_AGE_MS=900000

# Scheduled B2 rollup processor.
ROLLUP_LOOKBACK_HOURS=24
ROLLUP_MAX_RAW_OBJECTS=5000
ROLLUP_READ_CONCURRENCY=8
ROLLUP_UNIVERSE_IDS=

# Scheduled AI report processor.
AI_REPORT_BASE_URL=http://localhost:3000
AI_REPORT_SECRET=
AI_REPORT_TIMEOUT_MS=600000
